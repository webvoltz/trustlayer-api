NODE_ENV=development
PORT=3000

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/trustlayer

# JWT signing secret - use a long, random value (32+ characters) in every environment
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=1h

# Comma-separated list of allowed origins, or * for any
CORS_ORIGIN=http://localhost:5173

# General API rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Stricter rate limit applied to authentication endpoints
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5

# How long a password-reset token stays valid
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# Upload storage adapter: "local" (disk) or "s3"
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Required only when STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Include the raw password-reset token in API responses (defaults to on outside production)
EXPOSE_PASSWORD_RESET_TOKEN=
